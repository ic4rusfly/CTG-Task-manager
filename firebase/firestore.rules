rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn() && me().active == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isLead() {
      return isAdmin() || (isActive() && me().role == 'lead');
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    match /users/{uid} {
      allow read: if isActive();
      // A member edits only their own profile and can never change role/active.
      allow update: if isAdmin()
        || (isActive() && request.auth.uid == uid && unchanged(['role', 'active', 'email']));
      allow create, delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isActive();
      allow write: if isLead();
    }

    // Collection-group search over messages. The query filters on channelId,
    // and this rule re-checks membership of that conversation.
    match /{path=**}/messages/{messageId} {
      allow read: if isActive()
        && request.auth.uid in
           get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.memberIds;
    }

    match /channels/{channelId} {
      function member() {
        return isActive() && request.auth.uid in resource.data.memberIds;
      }
      allow read: if member() || (isActive() && resource.data.type in ['general', 'public']);
      allow create: if isActive() && request.auth.uid in request.resource.data.memberIds;
      // Membership changes are restricted to the creator, leads and admins.
      allow update: if member() && (unchanged(['memberIds', 'type'])
        || isLead() || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function channelMember() {
          return isActive() && request.auth.uid in
            get(/databases/$(database)/documents/channels/$(channelId)).data.memberIds;
        }
        allow read: if channelMember();
        allow create: if channelMember()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if channelMember()
          && (resource.data.senderId == request.auth.uid || unchanged(['text', 'attachments']));
        allow delete: if isAdmin() || (channelMember() && resource.data.senderId == request.auth.uid);
      }
    }

    match /projects/{projectId} {
      allow read: if isActive();
      allow write: if isLead();
    }

    match /tasks/{taskId} {
      allow read: if isActive();
      allow create, delete: if isLead();
      // Assignees may only move their own work forward.
      allow update: if isLead()
        || (isActive() && request.auth.uid in resource.data.assigneeIds
            && unchanged(['assigneeIds', 'reporterId', 'key', 'projectId']));

      match /comments/{commentId} {
        allow read: if isActive();
        allow create: if isActive() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin() || (isActive() && resource.data.authorId == request.auth.uid);
      }

      match /activity/{entryId} {
        allow read: if isActive();
        allow write: if false; // written by Cloud Functions only
      }
    }

    match /events/{eventId} {
      allow read: if isActive();
      allow create: if isActive();
      // Anyone invited may set their own RSVP; only the owner/lead edits the rest.
      allow update: if isLead() || resource.data.createdBy == request.auth.uid
        || (isActive() && request.auth.uid in resource.data.attendeeIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp']));
      allow delete: if isLead() || resource.data.createdBy == request.auth.uid;
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if signedIn() && request.auth.uid == uid;
      allow create: if false; // Cloud Functions only
    }
  }
}
